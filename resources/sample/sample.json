    "prompts": [
      {
        "key": "p1",
        "title": "16-bit 像素角色 sprite",
        "body": "16-bit pixel art character sprite, side view, 32×32 px, limited 16-color palette, crisp hard edges, no anti-aliasing, 1px dark outline, 2-tone shading. 角色居中、全身入画，站立待机姿势，透明背景。",
        "category": "风格",
        "uses": 24,
        "createdAt": "2026-09-20 10:00"
      },
      {
        "key": "p2",
        "title": "横版关卡背景分层",
        "body": "2D side-scrolling level background, split into 4 parallax layers: sky, far mountains, mid buildings, foreground props. 每层单独输出一张透明 PNG，1920×1080，左右可无缝拼接；前景层底部留出角色行走的地面。",
        "category": "用途",
        "uses": 18,
        "createdAt": "2026-09-19 10:00"
      },
      {
        "key": "p3",
        "title": "透明背景单体素材",
        "body": "single isolated game asset, centered, whole object in frame, transparent background (PNG with alpha), no ground shadow, no text, no watermark, no border. 只画一个物体，不要出多个变体。",
        "category": "约束",
        "uses": 31,
        "createdAt": "2026-09-18 10:00"
      },
      {
        "key": "p4",
        "title": "UI 按钮套装",
        "body": "game UI button set in pixel art: normal / hover / pressed / disabled states, 9-slice friendly borders, 48×16 px each, arranged in a neat grid on transparent background. 光源统一来自左上，按钮上不要文字。",
        "category": "用途",
        "uses": 9,
        "createdAt": "2026-09-17 10:00"
      },
      {
        "key": "p5",
        "title": "道具图标一组",
        "body": "a set of 16 RPG item icons: potion, key, lantern, coin, map, gem, scroll, bomb. 16×16 pixel art, consistent outline and lighting, 4×4 grid, each icon centered in its cell, transparent background. 同一组图标用同一套色板。",
        "category": "用途",
        "uses": 15,
        "createdAt": "2026-09-16 10:00"
      },
      {
        "key": "p6",
        "title": "水彩绘本场景",
        "body": "watercolor storybook illustration, soft wet-on-wet washes, visible paper texture, loose ink linework, warm muted palette, gentle morning light. 画面留白多，童话感，不要厚重描边。",
        "category": "风格",
        "uses": 9,
        "createdAt": "2026-09-15 10:00"
      },
      {
        "key": "p7",
        "title": "三视图设定稿",
        "body": "character turnaround sheet: front, side and back views, same scale and baseline, neutral standing pose, orthographic, evenly spaced on plain light gray background. 用细线标出头身比，三个视图的比例必须一致。",
        "category": "构图",
        "uses": 7,
        "createdAt": "2026-09-14 10:00"
      },
      {
        "key": "p8",
        "title": "通用负面词",
        "body": "blurry, low quality, jpeg artifacts, watermark, signature, text, logo, extra limbs, deformed hands, cropped, out of frame, duplicate, noisy background, oversaturated",
        "category": "负面词",
        "uses": 42,
        "createdAt": "2026-09-13 10:00"
      },
      {
        "key": "p9",
        "title": "像素网格严格对齐",
        "body": "strictly aligned to the pixel grid, every pixel one solid color, no blur, no gradients, no sub-pixel detail, nearest-neighbor scaling only. 输出尺寸是网格的整数倍，例如 32×32 放大到 512×512。",
        "category": "约束",
        "uses": 13,
        "createdAt": "2026-09-12 10:00"
      },
      {
        "key": "p10",
        "title": "游戏画面示意 16:9",
        "body": "in-game screenshot mockup, 16:9, side view camera, player at the left third of the frame, health bar top-left, item slots bottom-center, clear separation between foreground and background. 画面要像真实的游戏截图。",
        "category": "构图",
        "uses": 5,
        "createdAt": "2026-09-11 10:00"
      },
      {
        "key": "p11",
        "title": "赛璐璐日系立绘",
        "body": "anime cel-shaded character illustration, clean thin lineart, two-tone hard shadows, bright saturated colors, full body standing pose, white background. 平涂上色，方便后期抠图。",
        "category": "风格",
        "uses": 6,
        "createdAt": "2026-09-10 10:00"
      },
      {
        "key": "p12",
        "title": "像素风负面词",
        "body": "anti-aliasing, smooth gradients, soft brush, painterly, 3D render, photorealistic, blur, mixed pixel sizes, inconsistent resolution, noisy dithering",
        "category": "负面词",
        "uses": 18,
        "createdAt": "2026-09-09 10:00"
      }
    ],
